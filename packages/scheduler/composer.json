{
    "name": "quochao56/scheduler",
    "description": "Therapy & Class Scheduler package for Buoc Chan Nho",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "quochao56/core": "*@dev",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "autoload": {
        "psr-4": {
            "Quochao56\\Scheduler\\": "src/",
            "Quochao56\\Scheduler\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quochao56\\Scheduler\\SchedulerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
